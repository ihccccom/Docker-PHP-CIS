; =======================================================
; Snuffleupagus 安全规则配置文件
; PHP 运行时安全加固 - 防御常见攻击向量
; 路径: /opt/php/etc/snuffleupagus.rules
;
; 文档: https://snuffleupagus.readthedocs.io/
;
; 注意: 此文件仅在 USE_snuffleupagus=true 构建时生效
; =======================================================

; ============================================================
; Cookie 安全加固
; 注意：Snuffleupagus 的 sp.cookie 规则没有 httponly() / secure() 这两个关键字，
;       写了会导致 PHP 启动时 Fatal error。对应功能这样实现：
;   - Secure  ：sp.auto_cookie_secure，经 HTTPS 访问时自动给 Cookie 加 Secure 标志
;   - HttpOnly：由 php.ini 的 session.cookie_httponly=1 保证（仅会话 Cookie），
;               其他 Cookie 需由应用自己在 setcookie() 时设置
;   - SameSite：name_r 是正则匹配，".*" 表示所有 Cookie
; ============================================================
sp.auto_cookie_secure.enable();
sp.cookie.name_r(".*").samesite("strict");

; ============================================================
; 禁止不安全的 PHP 运行时设置
; 防止通过 ini_set() 降低安全级别
; ============================================================
sp.ini.key("assert.active").set("0").drop();
sp.ini.key("zend.assertions").set("-1").drop();

; ============================================================
; 禁用 XML 外部实体处理（防止 XXE 攻击）
; ============================================================
sp.xxe_protection.enable();

; ============================================================
; 限制文件上传的 MIME 类型（可选）
; 如需启用，创建验证脚本后取消注释
; ============================================================
; sp.upload_validation.script("/opt/php/etc/snuffleupagus_upload_check.sh").enable();

; ============================================================
; 防御 mail() 函数注入攻击（可选）
; 限制 mail() 函数仅允许指定来源，取消注释以启用
; 注意：此规则会限制通过外部 SMTP 发送邮件
; ============================================================
; sp.global.mail_allowlist("127.0.0.1").enable();

; ============================================================
; Session 加密（默认关闭）
; 启用 sp.session.encrypt() 必须先在 sp.global 里同时设置 secret_key 和 cookie_env_var，
; 否则 PHP 启动时报 Fatal error。官方还说明：无法解密的请求会被直接丢弃，
; 而密钥会绑定 cookie_env_var（如 REMOTE_ADDR），用户 IP 变化（手机切换网络等）
; 就会导致 Session 失效，且 secret_key 不能写进公开仓库。
; 在 Session 文件目录已是 www-data 专用 700 目录的前提下，收益有限、风险较高，
; 因此默认不启用。确需启用时，在部署环境的规则文件（卷内）里加入：
;   sp.global.secret_key("<随机 64 位字符，不要提交到仓库>");
;   sp.global.cookie_env_var("REMOTE_ADDR");
;   sp.session.encrypt();
; ============================================================
; sp.session.encrypt();

; ============================================================
; 限制 eval() 使用（如需完全禁用，取消注释下行）
; ============================================================
; sp.eval.blacklist(".*").drop();
